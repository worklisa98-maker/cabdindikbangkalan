LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cabdin_bangkalan?sslmode=disable
ZEABUR_DATABASE_URL=postgresql://user:pass@zeabur-host:5432/cabdin_bangkalan?sslmode=require
PGSSLMODE=require
MIGRATION_DIR=./migrations
BACKUP_DIR=./backups
RESET_TARGET=false
# Optional comma-separated list of tables to sample after migration
VERIFY_TABLES=schools,students,prestasi
