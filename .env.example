# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME=Cabdin Bangkalan
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
# Alternative fallback for frontend URL in backend report rendering.
FRONTEND_BASE_URL=http://localhost:3000

# Backend
APP_ENV=local
SYSTEM_TIME_OVERRIDE_ENABLED=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cabdin_bangkalan?sslmode=disable
JWT_SECRET=cabdindikbangkalan
PORT=8080
DB_POOL_MAX_CONNS=40
DB_POOL_MIN_CONNS=5
DB_POOL_MAX_CONN_LIFETIME=30m
DB_POOL_MAX_CONN_IDLE_TIME=10m
DB_POOL_HEALTH_CHECK_PERIOD=1m
# Required (32 bytes): base64 or hex, used to encrypt initial school-admin passwords at rest (AES-256-GCM).
MASTER_ENCRYPTION_KEY=

# Legacy (no longer used once MASTER_ENCRYPTION_KEY is set).
INITIAL_PASSWORD_ENCRYPTION_KEY=

STORAGE_PROVIDER=local
# Local development only. For staging/production use a persistent volume mount,
# for example STORAGE_LOCAL_DIR=/data/uploads
STORAGE_LOCAL_DIR=./uploads
REPORT_TOKEN_TTL_SECONDS=60
REPORT_PDF_CACHE_TTL_SECONDS=3600
REPORT_PDF_FILE_TTL_HOURS=48
REPORT_PDF_DIR=./uploads/reports
# Optional: set path if Chromium binary is not in PATH.
CHROME_EXECUTABLE_PATH=
# Optional: set to 1 to enable small "SIPRES" watermark on generated report PDF pages.
REPORT_PDF_WATERMARK=0

# Optional: Bootstrap initial ADMIN_MASTER (only used if no ADMIN_MASTER exists).
# INIT_ADMIN_MASTER_USERNAME=
# INIT_ADMIN_MASTER_PASSWORD=
# INIT_ADMIN_MASTER_NAMA_INSTANSI=Cabdin Master

# Optional: Cloudflare R2 (placeholder)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=

# Optional: Supabase Storage (placeholder)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# Kritik, saran & pengaduan publik. Secret hanya untuk backend.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Required to enable encrypted ADMIN_MASTER backups: base64 or hex, exactly 32 bytes.
# Store a copy outside this server. A backup cannot be restored without this key.
BACKUP_ENCRYPTION_KEY=
APP_VERSION=
